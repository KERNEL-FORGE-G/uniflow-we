<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_navy"
    android:padding="14dp">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UniFlow · Prochain Cours"
            android:textColor="#BAE6FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_teal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/widget_class_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 10:00"
                android:textColor="#A7F3D0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Content: Mascot + Course details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_cta_bar"
        android:layout_below="@id/header_bar"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Mascot rushing to class -->
        <ImageView
            android:id="@+id/widget_mascot_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Mascotte Uni"
            android:scaleType="fitCenter"
            android:src="@drawable/uni_duo_class_rush" />

        <!-- Course Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_course_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Algorithmique & Graphes"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_course_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📍 Amphithéâtre 250 · Dr. Mballa"
                android:textColor="#BAE6FD"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:id="@+id/bottom_cta_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_pill_teal"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_cta_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Voir mon Emploi du Temps"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
