# Appwrite Cloud (région Francfort) — projet « uniflow ». Valeurs publiques,
# côté client. Aucune clé serveur ici : le fichier est lu par Vite et embarqué.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=uniflow
VITE_APPWRITE_DATABASE_ID=uniflow
# Offre gratuite : un seul bucket. Documents, photos de profil et pièces
# jointes y cohabitent, les droits sont posés fichier par fichier.
VITE_APPWRITE_STORAGE_BUCKET_ID=uniflow_assets
VITE_APPWRITE_AVATAR_BUCKET_ID=uniflow_assets
# Une seule Function HTTP aiguille les neuf services sur le chemin appelé.
VITE_APPWRITE_API_FUNCTION_ID=uniflow-api
VITE_APP_URL=https://uniflow.kernelforge.codes
