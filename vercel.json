{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "https://api-uniflow.kernelforge.codes",
    "VITE_APP_URL": "https://uniflow.kernelforge.codes"
  }
}
